PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/deskdrop
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Frontend Base URL (used for CORS and invitation acceptance links)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Workspace Invitations Configuration
INVITATION_EXPIRES_DAYS=7

# SMTP email delivery (required to send invitations in every environment).
# Configure local development values in backend/.env; never commit real credentials.
# SMTP_FROM should be an address authorized by your SMTP provider.
#
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Boiler Plate <invitations@example.com>
